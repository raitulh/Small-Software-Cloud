# Local development defaults only. Never reuse these credentials in production.
APP_NAME=Small Software Cloud
CLOUD_ENV=development
API_V1_PREFIX=/v1
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET_KEY=local-only-replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+asyncpg://cloud:cloud_dev_only@localhost:5432/smallcloud
REDIS_URL=redis://redis:6379/0

# Deployment Driver: 'mock' (simulation only) or 'docker' (live local containers via Traefik)
DEPLOYMENT_DRIVER=mock
APPS_DOMAIN=localhost
APPS_NETWORK=smallcloud_apps

DEPLOYMENT_JOB_TIMEOUT_SECONDS=300
MAX_DEPLOYMENTS_PER_ORG_PER_HOUR=60
ALLOW_SIGNUPS=true
MAX_PROJECTS_PER_ORG=20
MAX_SERVICES_PER_ORG=50
DEFAULT_SERVICE_MEMORY_MB=256
DEFAULT_SERVICE_CPU_MILLICORES=250
MAX_SERVICE_MEMORY_MB=2048
MAX_SERVICE_CPU_MILLICORES=2000
RUNTIME_AGENT_URL=
RUNTIME_AGENT_SHARED_SECRET=
WORKLOAD_SANDBOX=disabled
